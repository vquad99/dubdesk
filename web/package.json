{
	"name": "dubbing-qc-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "node build",
		"migrate": "node scripts/migrate.mjs",
		"create-user": "node scripts/create-user.mjs",
		"test": "vitest run",
		"seed:scenarios": "node scripts/seed-scenarios.mjs"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"autocannon": "^8.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/noto-sans-devanagari": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"ffmpeg-static": "^5.3.0",
		"ffprobe-static": "^3.1.0",
		"pg": "^8.23.1",
		"qrcode": "^1.5.4"
	}
}
