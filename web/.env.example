# Postgres connection (local dev: output of scripts/dev_db.sh)
DATABASE_URL=postgres://dubbing@localhost:5544/dubbing_qc
# Behind Render's HTTPS proxy the real protocol and visitor address arrive in these headers
PROTOCOL_HEADER=x-forwarded-proto
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
# Optional: run the database tests (npm test) against this database
TEST_DATABASE_URL=postgres://dubbing@localhost:5544/dubbing_qc
